# Virtual environment — never commit this; it's recreated from requirements.txt
.venv/
venv/

# Secrets — NEVER commit the real API key
.env

# Python cache files
__pycache__/
*.pyc

# Jupyter checkpoint files
.ipynb_checkpoints/

# macOS system files
.DS_Store

# PyCharm settings
.idea/

# NOTE: data/ holds a small, sanitized SINGLE-CUSTOMER demo dataset (customer 1696) that IS
# committed so the app runs out of the box — see data/README.md. The full ~67MB multi-user
# dataset is intentionally not included. If you ever drop the full files in here, keep them out
# of git (uncomment below) so the 67MB transactions file isn't committed:
# data/transactions_full.csv
